# Copy this file to .env and fill in the key. Never commit .env.
XAI_API_KEY=your-key-here
# Optional. Overrides the xAI model ids in config.yaml.
# VISION_MODEL=grok-4.6
# DroidCam stream. The phone hotspot default is used when this is unset.
# CAMERA_STREAM_URL=http://172.20.10.1:4747/video
# Live searches are saved under server/data/scans. Replay one with
# POST /api/search {"query": "...", "scan_dir": "<folder name>"}.
# SEARCH_SCAN_DIR=server/data/scans
